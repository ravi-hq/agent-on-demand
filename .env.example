# Agent on Demand — local dev environment reference.
# Copy to `.env` and fill in real values: `cp .env.example .env`
# config/settings.py loads `.env` automatically via python-dotenv.
# `.env` is gitignored; this file is committed and must never hold real secrets.

# ── Sprites backend (REQUIRED) ────────────────────────────────────────────
# Single platform-owned token every session's microVM runs under. When unset,
# session creation returns 503 "Session backend is not configured"
# (views/sessions/create.py:86). Use a fresh, non-expired token.
SPRITES_API_KEY=

# Sprites API base. Default is fine; set only to point elsewhere.
# SPRITES_BASE_URL=https://api.sprites.dev

# ── At-rest field encryption ──────────────────────────────────────────────
# Encrypts stored session secrets / repo tokens / BYOK keys. No default; a
# missing key makes encrypt/decrypt throw (no plaintext fallback). Generate:
#   openssl rand -base64 32
# FIELD_ENCRYPTION_KEY=

# ── Optional overrides (defaults shown) ───────────────────────────────────
# DATABASE_URL=postgres://agent_on_demand:agent_on_demand@localhost:5460/agent_on_demand
# DJANGO_DEBUG=true
# SPRITE_NAME_PREFIX=aod
# DEFAULT_TIMEOUT=600
# DEFAULT_MAX_CONCURRENT_SESSIONS=100
